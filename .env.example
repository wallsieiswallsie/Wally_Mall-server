NODE_ENV=development
# Local binding; on Railway set HOST=0.0.0.0 and use Railway's injected PORT.
HOST=127.0.0.1
PORT=3001
# Required: fill with your PostgreSQL connection URI (URL-encode password).
DATABASE_URL=postgresql://wally:CHANGE_ME@127.0.0.1:5432/wally_mall
# Must be a separate disposable database; integration tests reset its public schema.
TEST_DATABASE_URL=
# Required: separate random values, each at least 32 characters. Server only.
ACCESS_TOKEN_SECRET=
# Exact browser origins, no trailing slash. Includes local dev and preview.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Keep mock for deployed testing, including NODE_ENV=production; no real payment is processed.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
# Allowed origins for legacy seller document URLs; new product media uses asset IDs.
MEDIA_ORIGINS=https://images.unsplash.com
# Server-only Google Cloud Storage configuration. Use JSON OR an ADC credential file.
GCS_BUCKET=wallymall-media-prod
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Non-negative whole rupiah. Pickup is always free. Server computes checkout fees.
BUYER_SERVICE_FEE=0
SELLER_DELIVERY_FEE=0
WALLY_LOCAL_FEE=0
# Optional, only for db:seed: explicit super admin email and 12+ character password.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
