{
  "name": "wally-mall-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "knex migrate:latest --knexfile database/knexfile.js",
    "migrate:status": "knex migrate:status --knexfile database/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile database/knexfile.js",
    "db:latest": "node --env-file-if-exists=.env database/cli.js latest",
    "db:status": "node --env-file-if-exists=.env database/cli.js status",
    "db:rollback": "node --env-file-if-exists=.env database/cli.js rollback",
    "db:seed": "node --env-file-if-exists=.env database/cli.js seed",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration.test.js",
    "payments:expire": "node --env-file-if-exists=.env src/expire.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
