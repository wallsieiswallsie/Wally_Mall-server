{
  "name": "wally-mall-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "npm run db:latest",
    "migrate:status": "npm run db:status",
    "migrate:rollback": "npm run db:rollback",
    "db:latest": "node --env-file-if-exists=.env database/cli.js latest",
    "db:status": "node --env-file-if-exists=.env database/cli.js status",
    "db:rollback": "node --env-file-if-exists=.env database/cli.js rollback",
    "db:seed": "node --env-file-if-exists=.env database/cli.js seed",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration.test.js",
    "payments:expire": "node --env-file-if-exists=.env src/expire.js",
    "media:cleanup": "node --env-file-if-exists=.env src/cleanup-media.js",
    "media:cors": "node --env-file-if-exists=.env src/media-cors.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google-cloud/storage": "^8.2.0",
    "fastify": "^5.6.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "overrides": {
    "gaxios": { "uuid": "^11.1.1" }
  }
}
